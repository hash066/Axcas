[Unit]
Description=Axcas typed Hermes tool bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=axcasbridge
Group=proofgate
WorkingDirectory=/opt/proofgate/ProofGate
Environment=NODE_ENV=production
Environment=AXCAS_BRIDGE_SOCKET=/run/axcas/tool-bridge.sock
Environment=AWS_REGION=ap-south-1
Environment=AXCAS_STRANDS_MODEL_ID=apac.amazon.nova-lite-v1:0
EnvironmentFile=/etc/proofgate/axcas-tool-bridge.env
RuntimeDirectory=axcas
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/bin/npm run start --workspace @axcas/tool-bridge
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
