FROM node:22-bookworm-slim AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm ci --ignore-scripts
RUN npx esbuild apps/hermes-sqs-relay/src/server.ts apps/axcas-tool-bridge/src/server.ts apps/aws-control-plane/src/workflow-task.ts \
    --bundle --platform=node --target=node22 --format=cjs --outbase=. --outdir=/out/dist

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10000 axcas-runtime \
    && useradd --uid 10001 --gid 10000 --create-home --shell /usr/sbin/nologin axcas
WORKDIR /opt/axcas
COPY --from=build /out/dist ./dist
RUN mkdir -p /run/axcas && chown -R 10001:10000 /opt/axcas /run/axcas
USER 10001:10000
CMD ["node", "dist/apps/hermes-sqs-relay/src/server.js"]
