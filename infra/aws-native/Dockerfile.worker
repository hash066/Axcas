FROM public.ecr.aws/docker/library/node:22-bookworm-slim AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm ci --ignore-scripts
RUN npx esbuild apps/hermes-sqs-relay/src/server.ts apps/axcas-tool-bridge/src/server.ts apps/aws-control-plane/src/workflow-task.ts apps/reel-guardian/src/server.ts \
    --bundle --platform=node --target=node22 --format=esm --packages=external --outbase=. --outdir=/out/dist \
    && npm prune --omit=dev --ignore-scripts

FROM public.ecr.aws/docker/library/node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10000 axcas-runtime \
    && useradd --uid 10001 --gid 10000 --create-home --shell /usr/sbin/nologin axcas
WORKDIR /opt/axcas
COPY --from=build /out/dist ./dist
COPY --from=build /workspace/node_modules ./node_modules
RUN mkdir -p /run/axcas && chown -R 10001:10000 /opt/axcas /run/axcas
USER 10001:10000
CMD ["node", "dist/apps/hermes-sqs-relay/src/server.js"]
