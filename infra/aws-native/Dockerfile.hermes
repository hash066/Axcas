FROM python:3.11-slim-bookworm

ARG HERMES_GIT_REF=88a58ff1355eabe468b4dcd4e152a596932632e6
LABEL org.opencontainers.image.version="0.18.2"
ENV HERMES_HOME=/var/lib/hermes \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 --branch "${HERMES_GIT_REF}" https://github.com/NousResearch/hermes-agent.git /opt/hermes \
    && pip install --no-cache-dir "/opt/hermes[messaging]" \
    && useradd --system --create-home --home-dir /var/lib/hermes hermes \
    && mkdir -p /var/lib/hermes/plugins/axcas /var/lib/hermes/skills/proofgate /run/axcas

COPY hermes/plugins/axcas /var/lib/hermes/plugins/axcas
COPY hermes/skills/proofgate /var/lib/hermes/skills/proofgate
COPY infra/aws-native/hermes-config.yaml /var/lib/hermes/config.yaml

RUN chown -R hermes:hermes /var/lib/hermes /run/axcas
USER hermes
WORKDIR /var/lib/hermes
CMD ["hermes", "--gateway"]
