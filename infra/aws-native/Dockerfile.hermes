FROM python:3.11-slim-bookworm

ARG HERMES_GIT_REF=88a58ff1355eabe468b4dcd4e152a596932632e6
LABEL org.opencontainers.image.version="0.18.2"
ENV HERMES_HOME=/var/lib/hermes \
    HF_HOME=/var/lib/hermes/.cache/huggingface \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git init /opt/hermes \
    && git -C /opt/hermes remote add origin https://github.com/NousResearch/hermes-agent.git \
    && git -C /opt/hermes fetch --depth 1 origin "${HERMES_GIT_REF}" \
    && git -C /opt/hermes checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/hermes rev-parse HEAD)" = "${HERMES_GIT_REF}" \
    && groupadd --gid 10000 axcas-runtime \
    && useradd --uid 10002 --gid 10000 --create-home --home-dir /var/lib/hermes --shell /usr/sbin/nologin hermes \
    && mkdir -p /var/lib/hermes/plugins/axcas /var/lib/hermes/skills/proofgate /var/lib/hermes/skills/axcas-brag /run/axcas

COPY infra/aws-native/hermes-public-channel.patch /tmp/hermes-public-channel.patch
COPY infra/aws-native/verify-hermes-runtime.py /tmp/verify-hermes-runtime.py
RUN git -C /opt/hermes apply --check /tmp/hermes-public-channel.patch \
    && git -C /opt/hermes apply /tmp/hermes-public-channel.patch \
    && pip install --no-cache-dir "/opt/hermes[messaging,bedrock,anthropic]" \
    && pip install --no-cache-dir "faster-whisper==1.2.1" \
    && python -c "from faster_whisper import WhisperModel; WhisperModel('base', device='cpu', compute_type='int8')" \
    && python /tmp/verify-hermes-runtime.py \
    && rm /tmp/hermes-public-channel.patch /tmp/verify-hermes-runtime.py

COPY hermes/plugins/axcas /var/lib/hermes/plugins/axcas
COPY hermes/skills/proofgate /var/lib/hermes/skills/proofgate
COPY hermes/skills/axcas-brag /var/lib/hermes/skills/axcas-brag
COPY infra/aws-native/hermes-config.yaml /var/lib/hermes/config.yaml

RUN chown -R 10002:10000 /var/lib/hermes /run/axcas
USER 10002:10000
WORKDIR /var/lib/hermes
CMD ["hermes", "gateway", "run"]
