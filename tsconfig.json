{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"],
  // The mobile app compiles against React Native and React 19 types, which are incompatible
  // with this project's Workers/Node `types` list. It is typechecked by its own tsconfig.
  "exclude": ["apps/axcas-mobile/**"]
}
